# Shell scripts and workflow files must stay LF: a core.autocrlf=true checkout
# on Windows would otherwise turn "set -euo pipefail" into "pipefail\r" and
# break bash before it starts. Manifest parsing separately tolerates CRLF in
# caller-owned flyers.conf files.
*.sh text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.yml text eol=lf
# .yaml too, for the same reason one step removed: aspect/ holds catalog
# entities read over a URL, and aspect/skeleton-*/ holds files rendered
# verbatim into other people's repos. Neither should carry whatever line
# ending the machine that last touched them happened to use.
*.yaml text eol=lf

